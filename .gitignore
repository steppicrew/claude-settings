# Ignore everything by default
*

# Track these top-level files
!.gitignore
!README.md
!CLAUDE.md
!settings.json
!sync.sh
!install-alias.sh

# Track project memory directories and their contents
!projects/
projects/*
!projects/*/
projects/*/*
!projects/*/memory/
!projects/*/memory/**

# Track plugin manifests only (marketplaces and cache reinstalled on pull)
!plugins/
plugins/*
!plugins/installed_plugins.json
!plugins/known_marketplaces.json
!plugins/blocklist.json
