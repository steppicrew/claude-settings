# Ignore everything by default
*

# Track these top-level files
!.gitignore
!README.md
!CLAUDE.md
!sync.sh
!install-alias.sh
!claude-memory-init.sh
!claude-memory-scan.sh
!test-config-sync.sh

# Hook bodies live here as tracked files because git does NOT clone .git/hooks/;
# sync.sh copies them into each machine's config repo on every run.
!hooks/
!hooks/*.sh

# Track config dir (symlinks only, not contents — contents live in private repos)
!config/
config/*
!config/current
